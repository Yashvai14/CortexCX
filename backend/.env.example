APP_NAME=CortexCX
APP_VERSION=1.0.0
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cortexcx_db

# Security & JWT Tokens
SECRET_KEY=your-super-secret-key-change-me-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI Provider Configuration (mock | openai)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings & Vector Search (mock | openai)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Telegram Channel Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=CortexCX_bot
TELEGRAM_WEBHOOK_SECRET=


# Local LLM + embeddings via Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
TELEGRAM_WORKSPACE_ID=

# First name the support persona uses with customers
SUPPORT_AGENT_NAME=Priya

# Hybrid router / memory / cache (defaults shown)
ROUTER_USE_LLM=true
ROUTER_MIN_CONFIDENCE=0.7
CONV_WINDOW_MESSAGES=8
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=600
